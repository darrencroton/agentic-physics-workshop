{
  "exercise": "explorer", "title": "Explorer: plan, build, test, review", "tool": "exploretool",
  "human_only": {},
  "models": {"default": "sonnet", "allowed": ["sonnet"]},
  "levels": [
    {"id": 0, "title": "Plan", "persona": "collaborator", "target_minutes": 8,
     "gate": {"type": "crypto-reflection", "check": ".gatekit/exploretool/checks/level0.py", "python": "venv", "timeout": 120,
              "questions": [],
              "reflection": "One thing in Claude's plan you changed, and why.",
              "post_unlock": "explore.record_head"}},
    {"id": 1, "title": "Build the prototype", "persona": "collaborator", "target_minutes": 18,
     "gate": {"type": "crypto", "check": ".gatekit/exploretool/checks/level1.py", "python": "venv", "timeout": 300,
              "questions": [{"id": "browser", "kind": "keyword",
                             "prompt": "Look at the page and answer the question in BRIEF.md for your dataset. (A word or two.)",
                             "text_from": "explore.browser_question",
                             "wrong_hint": "Pulsars: where are XX, YY and ZZ measured from? Dimuons: each narrow band along M is a particle; the one near 3.1 GeV has a two-letter name.",
                             "accept": ["sun", "the sun", "our sun", "solar system", "the solar system", "our solar system",
                                        "earth", "the earth", "us", "solar neighbourhood", "the solar neighbourhood",
                                        "solar neighborhood", "the solar neighborhood",
                                        "jpsi", "j/psi", "jψ", "psi", "the j/psi", "j/psi meson", "jpsi meson"]}],
              "reflection": "Each of you: one feature you would add. Which did the group like best?",
              "post_unlock": "explore.record_head"}},
    {"id": 2, "title": "Test", "persona": "collaborator", "target_minutes": 8,
     "files": {"TESTS.md": "TESTS.md"},
     "gate": {"type": "crypto-reflection", "check": ".gatekit/exploretool/checks/level2.py", "python": "venv", "timeout": 300,
              "questions": [],
              "reflection": "What did Claude's plan cover that yours didn't, or the reverse?",
              "post_unlock": "explore.record_head"}},
    {"id": 3, "title": "Review", "persona": "collaborator", "target_minutes": 8,
     "files": {"REVIEW.md": "REVIEW.md"},
     "gate": {"type": "crypto-reflection", "check": ".gatekit/exploretool/checks/level3.py", "python": "venv", "timeout": 300,
              "questions": [],
              "reflection": "What did the review find that the tests didn't?",
              "pre_reflection_note": "That was the last gate. PLAYBOOK.md is yours to take home: it works on any codebase, and .claude/agents/reviewer.md comes with it."}}
  ]
}
