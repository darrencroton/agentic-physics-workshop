{
  "model": "__MODEL__",
  "env": {
    "MPLCONFIGDIR": ".venv/.cache/matplotlib"
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": false,
    "filesystem": {
      "allowRead": [
        "./.vault",
        "./.gatekit",
        "./.claude"
      ]
    }
  },
  "permissions": {
    "defaultMode": "plan",
    "deny": [
      "Read(./.vault/**)",
      "Read(**/.vault/**)",
      "Read(./.gatekit/**)",
      "Read(**/.gatekit/**)",
      "Read(./.records/**)",
      "Read(./.claude/**)",
      "Edit(./.vault/**)",
      "Edit(**/.vault/**)",
      "Edit(./.gatekit/**)",
      "Edit(./.records/**)",
      "Edit(./.claude/**)",
      "Edit(./.tdd-tools/**)",
      "Edit(**/.claude/**)",
      "Bash(./gate unlock *)",
      "Bash(./gate hint *)",
      "Bash(./gate skip *)",
      "Bash(./gate reset *)",
      "Bash(./gate allow-model *)",
      "__HUMAN_ONLY_DENY__",
      "Bash(pip *)",
      "Bash(pip3 *)",
      "Bash(python3 -m pip *)",
      "Bash(python -m pip *)",
      "Bash(uv *)",
      "Bash(brew *)",
      "Bash(npm *)",
      "Bash(conda *)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.azure/**)",
      "Read(~/.kube/**)",
      "Read(~/.docker/**)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/.pypirc)",
      "Read(~/.claude.json)",
      "Read(~/.claude/.credentials.json)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/model_check.py"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/teacher_context.py"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Bash|Monitor|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.py"
            ],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PreModelSwitch": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/model_lock.py"
            ],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
